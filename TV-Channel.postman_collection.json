{
  "info": {
    "name": "TV Channel API",
    "_postman_id": "tv-channel-api-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Home Hero",
      "item": [
        {
          "name": "Get All",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/home-hero"
          }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/home-hero",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Watch Live TV\",\n  \"subtitle\": \"Stream your favourite shows anytime\",\n  \"liveButton\": \"Watch Now\",\n  \"exploreButton\": \"Explore Shows\",\n  \"badge\": \"HD\",\n  \"imageUrl\": \"https://picsum.photos/1920/1080\"\n}"
            }
          }
        },
        {
          "name": "Get By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/home-hero/{{heroId}}"
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/home-hero/{{heroId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\",\n  \"subtitle\": \"Updated subtitle\",\n  \"liveButton\": \"Go Live\",\n  \"exploreButton\": \"Browse\",\n  \"badge\": \"4K\",\n  \"imageUrl\": \"https://picsum.photos/1920/1080\"\n}"
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/home-hero/{{heroId}}"
          }
        }
      ]
    },
